# Cổng máy chủ Backend
PORT=5000

# Google Gemini API Key (Bản Free Tier)
# Lấy key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Đường dẫn cơ sở dữ liệu SQLite
DB_PATH=./server/database/finance.db

# Model Gemini (phân tách bằng dấu phẩy)
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Timeout gọi Gemini (ms). SPEC mặc định 5000; tăng lên (vd 8000) nếu free tier hay chậm
GEMINI_TIMEOUT_MS=5000

{
  "name": "personal-finance-management",
  "version": "1.0.0",
  "description": "Personal Finance Management with Budget Alerts and Financial Insights",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "test": "node --test tests/**/*.test.js",
    "build": "vite build",
    "start": "node server/index.js",
    "sprites": "python scripts/build_pet_sprites.py"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "motion": "^14.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
